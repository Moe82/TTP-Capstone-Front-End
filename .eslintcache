:"217","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"218","messages":"219","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"220","messages":"221","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"222","messages":"223","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"224","messages":"225","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"226","messages":"227","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"228","messages":"229","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"230","messages":"231","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"232","messages":"233","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"234","messages":"235","errorCount":0,"fatalErrorCount":0,"warningCount":7,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"236","messages":"237","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/index.js",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/App/App.js",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/redux/store.js",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/redux/root-reducer.js",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/routes/RoutesContainer.jsx",["238"],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/redux/teacher/teacher.js",["239"],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/routes/RoutesView.jsx",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/containers/Courses/CourseList.js",["240","241"],"import React from 'react';\r\nimport { Field, reduxForm,reset} from 'redux-form';\r\nimport { connect} from 'react-redux';\r\nimport { Link } from 'react-router-dom'\r\nimport { createCourse, fetchCourses, deleteCourse } from '../../../redux/course/courseReducer';\r\nclass CourseList extends React.Component {\r\n  constructor(props) {\r\n    super(props);\r\n    this.state = { courseName: '' }\r\n  }\r\n  componentDidMount = () => {\r\n    // not good logic, but it fixes the delete button issue for now. \r\n    if (this.props.courses.length == 0) {\r\n      this.props.fetchCourses(this.props.teacherId)\r\n    }\r\n  }\r\n  renderError = ({ error, touched }) => {\r\n    if (touched && error) {\r\n      return (\r\n        <div className=\"ui error message\">\r\n          <div className=\"header\">{error}</div>\r\n        </div>\r\n      )\r\n    }\r\n  }\r\n  renderInput = ({ input, label, meta }) => {\r\n    return (\r\n      <div className=\"field\">\r\n        <label>{label}</label>\r\n        <input  style={{ width: '25%', borderColor: '#AE81FF' }} {...input}  />\r\n        <div>{this.renderError(meta)}</div>\r\n      </div>\r\n    )\r\n  }\r\n  onSubmit = (formValues,dispatch) => {\r\n    this.props.createCourse(formValues, this.props.teacherId);\r\n    dispatch(reset('courseCreate'));\r\n  }\r\n\r\n\r\n  render() {\r\n    return (\r\n      <div>\r\n        User: {this.props.email} <br /><br />\r\n        <form onSubmit={this.props.handleSubmit(this.onSubmit)} className=\"ui form error\">\r\n          <Field  name=\"name\" component={this.renderInput} label=\"Add a course:\" />\r\n          <button style={{ backgroundColor: '#AE81FF' }} className=\"ui button primary\">Add Corurse</button>\r\n        </form>\r\n        <br /><br />\r\n        {this.props.courses.length == 0 ? null :\r\n          <div>\r\n            <h1>Courses:</h1>\r\n            <div className=\"ui celled list\">\r\n              {\r\n                this.props.courses.map(course => {\r\n                  return (\r\n                    <div className=\"item\" key={course.id}>\r\n                      <div className=\"right floated content\">\r\n                        <Link to={`/course/edit/${course.id}`} className=\"ui button green\" courseId={course.id}>Edit name</Link>\r\n                        <Link onClick={() => { this.props.history.push(`/course/delete/${course.id}`) }} className=\"ui button negative\">Delete</Link>\r\n                        <Link className=\"ui button teal\" to={`/course/${course.id}/students`}>Add Students</Link>\r\n                        <Link to={`/course/upload/${course.id}`} className=\"ui button yellow\">Upload attendance</Link>\r\n                        <Link to={`/course/${course.id}/attendance`} className=\"ui button primary\">View Attendance</Link>\r\n                      </div>\r\n                      <div className=\"content\" style={{ fontSize: '1.5rem' }}>\r\n                        {course.name}\r\n                      </div>\r\n                    </div>)\r\n                })\r\n              }\r\n            </div>\r\n          </div>\r\n        }\r\n      </div>\r\n    );\r\n  }\r\n}\r\n\r\nconst validate = (formValues) => {\r\n  const errors = {};\r\n\r\n  if (!formValues.name) {\r\n    errors.name = \"You must enter Course name\"\r\n  }\r\n  return errors;\r\n}\r\nconst formWrapped = reduxForm({\r\n  form: 'courseCreate',\r\n  validate\r\n})(CourseList);\r\n\r\n\r\nconst mapStateToProps = (state) => {\r\n  return {\r\n    courses: Object.values(state.courses),\r\n    teacherId: state.teacher.id,\r\n    email: state.teacher.email\r\n  }\r\n}\r\nexport default connect(mapStateToProps, { createCourse, fetchCourses, deleteCourse })(formWrapped);",["242","243"],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/redux/teacher/index.js",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/containers/index.js",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/containers/Courses/CourseDelete.js",["244"],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/containers/Courses/CourseEdit.js",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/containers/Students/StudentList.js",["245"],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/containers/UploadAttendanceContainer.js",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/containers/StudentInfoContainer.js",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/containers/AuthFormContainer.jsx",["246"],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/containers/NavbarContainer.jsx",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/views/ModelView.js",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/views/StudentInfoView.jsx",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/views/index.js",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/views/AuthFormView.jsx",["247","248","249","250","251","252","253"],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/views/UploadAttendanceView.jsx",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/views/NavbarView.jsx",["254"],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/back-end-url.js",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/views/DatepickerView.js",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/containers/Courses/CourseAttendance.js",["255","256"],"import React from 'react';\r\nimport axios from 'axios';\r\nimport BACK_END from '../../../back-end-url'\r\n\r\nclass CourseAttendance extends React.Component {\r\n    constructor(props) {\r\n        super(props);\r\n        this.state = { data: {} };\r\n    }\r\n    componentDidMount() {\r\n        axios.get(`${BACK_END}/api/students/attendance/${this.props.match.params.id}`)\r\n            .then(response => {\r\n                console.log(\"DATA:\", response)\r\n                this.setState({\r\n                    data: response.data.data\r\n                })\r\n            })\r\n\r\n    }\r\n    renderDates() {\r\n        const dates = [];\r\n        for (let name of Object.keys(this.state.data)) {\r\n            for (let date in this.state.data[name]) {\r\n                dates.push(date);\r\n            }\r\n            break;\r\n        }\r\n        let n = dates.length;\r\n        for (let i = 0; i < n; i++) {\r\n            dates[i] = (dates[i].substr(3))\r\n        }\r\n        return dates.map(date => {\r\n            return (\r\n                <th>{date}</th>\r\n            )\r\n        })\r\n    }\r\n    renderStudentList() {\r\n        const studentName = [];\r\n        for (let name in this.state.data) {\r\n            studentName.push(name)\r\n        }\r\n        return studentName.map(student => {\r\n\r\n            return (\r\n                <tr>\r\n                    <td>{student}</td>\r\n                    {this.renderAttendance(student)}\r\n                </tr>\r\n            )\r\n        })\r\n    }\r\n    renderAttendance(student) {\r\n        const attendances = [];\r\n\r\n        for (const [key, value] of Object.entries(this.state.data[student])) {\r\n            attendances.push(value);\r\n        }\r\n        return attendances.map(attendance => {\r\n            return (\r\n                <td>{attendance}</td>\r\n            )\r\n        })\r\n\r\n    }\r\n    render() {\r\n        return (\r\n            <div>\r\n                <table className=\"ui celled table\">\r\n                    <thead>\r\n                        <tr>\r\n                            <th>Names</th>\r\n                            {this.renderDates()}\r\n                        </tr>\r\n                    </thead>\r\n                    <tbody>\r\n                        {this.renderStudentList()}\r\n                    </tbody>\r\n                </table>\r\n            </div>\r\n        )\r\n    }\r\n}\r\nexport default CourseAttendance;","/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/components/containers/Courses/CourseView.js",[],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/redux/student/studentReducer.js",["257","258"],"/Users/mohamedshafee/Documents/TTP/Capstone/TTP-Capstone-Front-End/src/redux/course/courseReducer.js",["259","260"],"/Users/Moe/Documents/TTP-Capstone-Front-End/src/index.js",[],"/Users/Moe/Documents/TTP-Capstone-Front-End/src/App/App.js",[],"/Users/Moe/Documents/TTP-Capstone-Front-End/src/redux/store.js",[],"/Users/Moe/Documents/TTP-Capstone-Front-End/src/redux/root-reducer.js",[],"/Users/Moe/Documents/TTP-Capstone-Front-End/src/components/routes/RoutesContainer.jsx",["261"],"/Users/Moe/Documents/TTP-Capstone-Front-End/src/redux/course/courseReducer.js",["262","263"],"/Users/Moe/Documents/TTP-Capstone-Front-End/src/redux/teacher/teacher.js",["264"],"/Users/Moe/Documents/TTP-Capstone-Front-End/src/redux/student/studentReducer.js",["265","266"],"/Users/Moe/Documents/TTP-Capstone-Front-End/src/components/routes/RoutesView.jsx",[],"/Users/Moe/Documents/TTP-Capstone-Front-End/src/back-end-url.js",[],"/Users/Moe/Documents/TTP-Capstone-Front-End/src/components/containers/Courses/CourseList.js",["267","268"],"/Users/Moe/Documents/TTP-Capstone-Front-End/src/